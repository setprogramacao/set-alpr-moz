# ============================================================================
# SISTEMA ALPR UNIPIAGET - Configurações de Ambiente
# ============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário

# ============================================================================
# API CONFIGURATION (Web Module)
# ============================================================================

# URL da API (usado pelo Desktop Module para enviar detecções)
API_HOST=http://localhost:8000

# Timeout para requisições (segundos)
API_TIMEOUT=30


# ============================================================================
# DATABASE CONFIGURATION (Web Module)
# ============================================================================

# URL do banco de dados
# SQLite (padrão): sqlite:///./alpr_unipiaget.db
# PostgreSQL: postgresql://usuario:senha@localhost/alpr_unipiaget
DATABASE_URL=sqlite:///./alpr_unipiaget.db


# ============================================================================
# SECURITY (Web Module)
# ============================================================================

# Chave secreta para JWT (MUDE EM PRODUÇÃO!)
SECRET_KEY=sua-chave-secreta-super-segura-mude-em-producao-12345

# Tempo de expiração do token em minutos (padrão: 1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ============================================================================
# YOLO CONFIGURATION (Desktop Module)
# ============================================================================

# Caminho para o modelo YOLO
YOLO_MODEL_PATH=desktop-module/models/yolov8n.pt

# Threshold de confiança para detecção (0.0 a 1.0)
YOLO_CONFIDENCE=0.5

# Threshold de IOU para supressão não-máxima
YOLO_IOU=0.45

# Dispositivo: "cpu" ou "cuda" (GPU)
YOLO_DEVICE=cpu


# ============================================================================
# OCR CONFIGURATION (Desktop Module)
# ============================================================================

# Método OCR: "easyocr", "tesseract" ou "hibrido"
OCR_METHOD=hibrido

# Idiomas para OCR (separados por vírgula)
OCR_LANGUAGES=en

# Confiança mínima para aceitar OCR (0.0 a 1.0)
OCR_MIN_CONFIDENCE=0.6

# EasyOCR usar GPU (true/false)
EASYOCR_GPU=false

# Caminho do executável Tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: tesseract
TESSERACT_CMD=tesseract


# ============================================================================
# VIDEO/CAMERA CONFIGURATION (Desktop Module)
# ============================================================================

# Fonte de vídeo
# "0" = webcam padrão
# "1" = segunda webcam
# "caminho/para/video.mp4" = arquivo de vídeo
VIDEO_SOURCE=0

# Processar apenas 1 a cada N frames (para performance)
PROCESS_EVERY_N_FRAMES=5

# Resolução de processamento
FRAME_RESIZE_WIDTH=640
FRAME_RESIZE_HEIGHT=480

# Limite de FPS
FPS_LIMIT=30


# ============================================================================
# DETECTION CONFIGURATION (Desktop Module)
# ============================================================================

# Cooldown entre detecções da mesma placa (segundos)
# Evita registros duplicados
DETECTION_COOLDOWN=300

# Salvar imagens das detecções (true/false)
SAVE_DETECTION_IMAGES=true

# Tipo de movimento padrão: "entrada" ou "saida"
DEFAULT_MOVEMENT_TYPE=entrada

# Auto alternar tipo de movimento após cada detecção (true/false)
AUTO_TOGGLE_MOVEMENT=true


# ============================================================================
# UI CONFIGURATION (Desktop Module)
# ============================================================================

# Dimensões da janela
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800


# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
